{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug Pico 2 W",
      "cwd": "${workspaceFolder}",
      "chip": "RP235x",
      "connectUnderReset": false,
      "speed": 4000,
      "runtimeExecutable": "probe-rs",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/${workspaceFolderBasename}",
          "rttEnabled": true
        }
      ]
    }
  ]
}